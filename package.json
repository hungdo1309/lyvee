{
  "name": "lyvee",
  "version": "1.2.0",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": ["@react-navigation/drawer"]
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/drawer": "7.5.8",
    "@react-navigation/material-top-tabs": "^7.4.27",
    "date-fns": "^4.3.0",
    "expo": "~54.0.35",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.13.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pager-view": "6.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "rn-emoji-keyboard": "^1.7.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@types/react": "~19.1.10",
    "firebase-tools": "^14.0.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start --lan",
    "start:tunnel": "node scripts/expo-tunnel.mjs",
    "start:remote": "powershell -ExecutionPolicy Bypass -File scripts/start-remote.ps1",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:dev": "npx eas-cli build --profile development --platform all",
    "build:preview": "npx eas-cli build --profile preview --platform all",
    "build:android": "npx eas-cli build --profile production --platform android",
    "build:ios": "npx eas-cli build --profile production --platform ios",
    "build:all": "npx eas-cli build --profile production --platform all",
    "submit:android": "npx eas-cli submit --platform android --latest --profile production",
    "submit:ios": "npx eas-cli submit --platform ios --latest --profile production",
    "deploy:firebase": "firebase deploy --only functions,firestore:rules,firestore:indexes"
  },
  "private": true
}
