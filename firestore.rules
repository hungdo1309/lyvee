rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    function isGroupOwner(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    function groupAdminIds(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.get('adminIds', []);
    }

    function isGroupAdmin(groupId) {
      return request.auth.uid in groupAdminIds(groupId);
    }

    function isGroupManager(groupId) {
      return isGroupOwner(groupId) || isGroupAdmin(groupId);
    }

    function groupInviteFieldsUnchanged() {
      return request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function groupAdminIdsUnchanged() {
      return request.resource.data.get('adminIds', []) == resource.data.get('adminIds', []);
    }

    function isJoiningGroup() {
      return request.auth.uid in request.resource.data.members
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && groupInviteFieldsUnchanged()
        && groupAdminIdsUnchanged();
    }

    function isMemberLeaving() {
      return request.auth.uid in resource.data.members
        && resource.data.ownerId != request.auth.uid
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && groupInviteFieldsUnchanged()
        && (
          groupAdminIdsUnchanged()
          || (
            request.auth.uid in resource.data.get('adminIds', [])
            && request.resource.data.get('adminIds', []).size()
              == resource.data.get('adminIds', []).size() - 1
          )
        );
    }

    function isOwnerRemovingMember(groupId) {
      return isGroupOwner(groupId)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && resource.data.ownerId in request.resource.data.members
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && groupInviteFieldsUnchanged()
        && request.resource.data.get('adminIds', []).size()
          <= resource.data.get('adminIds', []).size()
        && request.resource.data.get('adminIds', []).size()
          >= resource.data.get('adminIds', []).size() - 1;
    }

    function isAdminRemovingMember(groupId) {
      return isGroupAdmin(groupId)
        && !isGroupOwner(groupId)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && resource.data.ownerId in request.resource.data.members
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && groupInviteFieldsUnchanged()
        && groupAdminIdsUnchanged();
    }

    function isManagerRenaming(groupId) {
      return isGroupManager(groupId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name != resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.members == resource.data.members
        && groupInviteFieldsUnchanged()
        && groupAdminIdsUnchanged();
    }

    function isManagerRegeneratingInvite(groupId) {
      return isGroupManager(groupId)
        && request.resource.data.inviteCode != resource.data.inviteCode
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.members == resource.data.members
        && request.resource.data.createdAt == resource.data.createdAt
        && groupAdminIdsUnchanged();
    }

    function isPromotingMemberToAdmin(groupId) {
      return isGroupManager(groupId)
        && request.resource.data.members == resource.data.members
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && groupInviteFieldsUnchanged()
        && request.resource.data.get('adminIds', []).size()
          == resource.data.get('adminIds', []).size() + 1;
    }

    function isDemotingAdminToMember(groupId) {
      return isGroupOwner(groupId)
        && request.resource.data.members == resource.data.members
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && groupInviteFieldsUnchanged()
        && request.resource.data.get('adminIds', []).size()
          == resource.data.get('adminIds', []).size() - 1;
    }

    function isOwnerTransferringOwnership(groupId) {
      return isGroupOwner(groupId)
        && request.resource.data.ownerId != resource.data.ownerId
        && request.resource.data.ownerId in request.resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.name == resource.data.name
        && groupInviteFieldsUnchanged()
        && request.resource.data.get('adminIds', []).size()
          <= resource.data.get('adminIds', []).size()
        && request.resource.data.get('adminIds', []).size()
          >= resource.data.get('adminIds', []).size() - 1;
    }

    function canReadItemData(data) {
      return isGroupMember(data.groupId)
        && (
          request.auth.uid == data.createdBy
          || request.auth.uid in data.get('assignedTo', [])
          || data.get('visibility', 'everyone') == 'everyone'
          || (
            data.get('visibility', 'everyone') == 'custom'
            && request.auth.uid in data.get('allowedMembers', [])
          )
        );
    }

    function canReadItemById(itemId) {
      return canReadItemData(get(/databases/$(database)/documents/items/$(itemId)).data);
    }

    function itemGroupId(itemId) {
      return get(/databases/$(database)/documents/items/$(itemId)).data.groupId;
    }

    function canAccessItemComments(itemId) {
      return isAuthenticated() && canReadItemById(itemId);
    }

    function canAccessTrip(groupId, data) {
      return isGroupMember(groupId)
        && (
          isGroupManager(groupId)
          || data.createdBy == request.auth.uid
          || !('memberIds' in data)
          || data.get('memberIds', []).size() == 0
          || request.auth.uid in data.get('memberIds', [])
        );
    }

    function canManageTripExpenseGroupById(groupId, tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      return trip.groupId == groupId
        && (
          trip.createdBy == request.auth.uid
          || isGroupManager(groupId)
        );
    }

    function isUpdatingTripExpenseGroupLink(tripId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isGroupMember(resource.data.groupId)
        && canManageTripExpenseGroupById(resource.data.groupId, tripId)
        && request.resource.data.updatedAt is string
        && changedKeys.hasOnly(['expenseGroupId', 'updatedAt'])
        && (
          (
            request.resource.data.expenseGroupId is string
            && request.resource.data.expenseGroupId
              != resource.data.get('expenseGroupId', '')
          )
          || (
            !('expenseGroupId' in request.resource.data)
            && 'expenseGroupId' in resource.data
          )
        );
    }

    function tripMemberIdsValid(memberIds) {
      return memberIds is list
        && memberIds.size() > 0
        && memberIds.size() <= 50;
    }

    function tripMemberIdsValidForWrite(data) {
      return !('memberIds' in data)
        || data.get('memberIds', []).size() == 0
        || tripMemberIdsValid(data.memberIds);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isAuthenticated()
          && request.auth.uid == request.resource.data.actorId
          && request.resource.data.userId == userId
          && request.resource.data.readAt == null
          && request.resource.data.title is string
          && request.resource.data.body is string
          && request.resource.data.createdAt is string;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt is string;
        allow delete: if isOwner(userId);
      }
    }

    match /invites/{inviteCode} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && isGroupManager(request.resource.data.groupId);
      allow update: if isAuthenticated() && isGroupManager(resource.data.groupId);
      allow delete: if isAuthenticated() && isGroupManager(resource.data.groupId);
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if isAuthenticated() && (
        isJoiningGroup()
        || isMemberLeaving()
        || isOwnerRemovingMember(groupId)
        || isAdminRemovingMember(groupId)
        || isManagerRenaming(groupId)
        || isManagerRegeneratingInvite(groupId)
        || isPromotingMemberToAdmin(groupId)
        || isDemotingAdminToMember(groupId)
        || isOwnerTransferringOwnership(groupId)
      );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /items/{itemId} {
      allow read: if isAuthenticated() && canReadItemData(resource.data);
      allow create: if isAuthenticated()
        && isGroupMember(request.resource.data.groupId)
        && request.auth.uid in request.resource.data.get('visibleTo', []);
      allow update, delete: if isAuthenticated() && canReadItemData(resource.data);

      match /comments/{commentId} {
        allow read: if canAccessItemComments(itemId);

        allow create: if canAccessItemComments(itemId)
          && request.auth.uid == request.resource.data.authorId
          && request.resource.data.itemId == itemId
          && request.resource.data.groupId == itemGroupId(itemId)
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.mentionUserIds is list
          && request.resource.data.mentionUserIds.size() <= 50
          && request.resource.data.mentionEveryone is bool
          && !(request.auth.uid in request.resource.data.mentionUserIds);

        allow update: if canAccessItemComments(itemId) && (
          (
            request.auth.uid == resource.data.authorId
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.itemId == resource.data.itemId
            && request.resource.data.groupId == resource.data.groupId
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 2000
            && request.resource.data.mentionUserIds is list
            && request.resource.data.mentionUserIds.size() <= 50
            && request.resource.data.mentionEveryone is bool
            && !(request.auth.uid in request.resource.data.mentionUserIds)
          )
          || (
            request.resource.data.authorId == resource.data.authorId
            && request.resource.data.itemId == resource.data.itemId
            && request.resource.data.groupId == resource.data.groupId
            && request.resource.data.body == resource.data.body
            && request.resource.data.mentionUserIds == resource.data.mentionUserIds
            && request.resource.data.mentionEveryone == resource.data.mentionEveryone
            && request.resource.data.parentCommentId == resource.data.parentCommentId
            && request.resource.data.threadRootId == resource.data.threadRootId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.reactionCounts is map
            && request.resource.data.updatedAt is string
          )
        );

        allow delete: if canAccessItemComments(itemId) && (
          request.auth.uid == resource.data.authorId
          || (
            resource.data.threadRootId != null
            && resource.data.threadRootId != commentId
            && get(/databases/$(database)/documents/items/$(itemId)/comments/$(resource.data.threadRootId)).data.authorId
              == request.auth.uid
          )
        );

        match /reactions/{reactorId} {
          allow read: if canAccessItemComments(itemId);
          allow create, update: if canAccessItemComments(itemId)
            && request.auth.uid == reactorId
            && request.resource.data.userId == reactorId
            && request.resource.data.emoji is string
            && request.resource.data.emoji.size() > 0
            && request.resource.data.emoji.size() <= 8
            && request.resource.data.createdAt is string;
          allow delete: if canAccessItemComments(itemId) && request.auth.uid == reactorId;
        }
      }
    }

    match /trips/{tripId} {
      allow read: if isAuthenticated()
        && canAccessTrip(resource.data.groupId, resource.data);
      allow create: if isAuthenticated()
        && isGroupMember(request.resource.data.groupId)
        && request.resource.data.createdBy == request.auth.uid
        && tripMemberIdsValid(request.resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.destination is string
        && request.resource.data.destination.size() >= 2
        && request.resource.data.destination.size() <= 120
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.days is list
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && (
          !('placeId' in request.resource.data)
          || request.resource.data.placeId is string
        )
        && (
          !('destinationSource' in request.resource.data)
          || request.resource.data.destinationSource in ['search', 'manual']
        )
        && (
          !('expenseGroupId' in request.resource.data)
          || request.resource.data.expenseGroupId is string
        );
      allow update: if isAuthenticated() && (
        (
          canAccessTrip(resource.data.groupId, resource.data)
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && tripMemberIdsValidForWrite(request.resource.data)
          && (
            !('memberIds' in request.resource.data)
            || request.resource.data.get('memberIds', []).size() == 0
            || request.resource.data.createdBy in request.resource.data.memberIds
          )
          && request.resource.data.destination is string
          && request.resource.data.destination.size() >= 2
          && request.resource.data.destination.size() <= 120
          && request.resource.data.startDate is string
          && request.resource.data.endDate is string
          && request.resource.data.days is list
          && request.resource.data.updatedAt is string
          && (
            !('destinationDetail' in request.resource.data)
            || request.resource.data.destinationDetail is string
          )
          && (
            !('placeId' in request.resource.data)
            || request.resource.data.placeId is string
          )
          && (
            !('destinationSource' in request.resource.data)
            || request.resource.data.destinationSource in ['search', 'manual']
          )
          && (
            !('expenseGroupId' in request.resource.data)
            || request.resource.data.expenseGroupId is string
          )
        )
        || isUpdatingTripExpenseGroupLink(tripId)
      );
      allow delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid
        || isGroupManager(resource.data.groupId)
      );
    }

    function expenseGroupMemberIdsValid(memberIds) {
      return memberIds is list
        && memberIds.size() > 0
        && memberIds.size() <= 50;
    }

    function isTripMemberForExpense(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      return trip.groupId is string
        && isGroupMember(trip.groupId)
        && (
          isGroupManager(trip.groupId)
          || trip.createdBy == request.auth.uid
          || !('memberIds' in trip)
          || trip.get('memberIds', []).size() == 0
          || request.auth.uid in trip.get('memberIds', [])
        );
    }

    function canReadExpenseGroup(groupId, data) {
      return isGroupMember(groupId) && (
        data.get('isDefault', false) == true
          && request.auth.uid in data.memberIds
        || (
          !('tripId' in data) || data.tripId == ''
        ) && !data.get('isDefault', false)
          && (
            isGroupManager(groupId)
            || request.auth.uid in data.memberIds
          )
        || ('tripId' in data) && data.tripId is string
          && (
            isTripMemberForExpense(data.tripId)
            || request.auth.uid in data.memberIds
          )
      );
    }

    match /expenseGroups/{expenseGroupId} {
      allow read: if isAuthenticated()
        && canReadExpenseGroup(resource.data.groupId, resource.data);
      allow create: if isAuthenticated()
        && isGroupMember(request.resource.data.groupId)
        && request.resource.data.createdBy == request.auth.uid
        && expenseGroupMemberIdsValid(request.resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.currency is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && (
          !('tripId' in request.resource.data)
          || (
            request.resource.data.tripId is string
            && canManageTripExpenseGroupById(
              request.resource.data.groupId,
              request.resource.data.tripId
            )
          )
        )
        && (
          !('isDefault' in request.resource.data)
          || request.resource.data.isDefault is bool
        )
        && (
          !request.resource.data.get('isDefault', false)
          || !('tripId' in request.resource.data)
        );
      allow update: if isAuthenticated()
        && (
          canReadExpenseGroup(resource.data.groupId, resource.data)
          || (
            ('tripId' in resource.data) && resource.data.tripId is string
            && canManageTripExpenseGroupById(
              resource.data.groupId,
              resource.data.tripId
            )
          )
        )
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('isDefault', false)
          == resource.data.get('isDefault', false)
        && expenseGroupMemberIdsValid(request.resource.data.memberIds)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.updatedAt is string
        && (
          !('tripId' in request.resource.data)
          || request.resource.data.tripId == resource.data.tripId
        );
      allow delete: if isAuthenticated()
        && !resource.data.get('isDefault', false)
        && (
          (
            !('tripId' in resource.data) || resource.data.tripId == ''
          ) && (
            resource.data.createdBy == request.auth.uid
            || isGroupManager(resource.data.groupId)
          )
          || ('tripId' in resource.data) && resource.data.tripId is string
            && canManageTripExpenseGroupById(
              resource.data.groupId,
              resource.data.tripId
            )
        );

      match /expenses/{expenseId} {
        allow read: if isAuthenticated()
          && canReadExpenseGroup(
            get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data.groupId,
            get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data
          );
        allow create: if isAuthenticated()
          && canReadExpenseGroup(
            get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data.groupId,
            get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data
          )
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 120
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.paidByUserId is string
          && request.resource.data.paidByUserId in get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data.memberIds
          && request.resource.data.splitAmongUserIds is list
          && request.resource.data.expenseDate is string
          && (
            !('splitMode' in request.resource.data)
            || request.resource.data.splitMode in ['equal', 'exact', 'percentage', 'shares']
          )
          && (
            !('splitValues' in request.resource.data)
            || request.resource.data.splitValues is map
          )
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string;
        allow update, delete: if isAuthenticated()
          && canReadExpenseGroup(
            get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data.groupId,
            get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data
          );
      }

      match /settlements/{settlementId} {
        allow read: if isAuthenticated()
          && canReadExpenseGroup(
            get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data.groupId,
            get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data
          );
        allow create: if isAuthenticated()
          && canReadExpenseGroup(
            get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data.groupId,
            get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data
          )
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.fromUserId is string
          && request.resource.data.fromUserId in get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data.memberIds
          && request.resource.data.toUserId is string
          && request.resource.data.toUserId in get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data.memberIds
          && request.resource.data.fromUserId != request.resource.data.toUserId
          && request.resource.data.settlementDate is string
          && (
            !('expenseId' in request.resource.data)
            || request.resource.data.expenseId is string
          )
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string;
        allow update, delete: if isAuthenticated()
          && canReadExpenseGroup(
            get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data.groupId,
            get(/databases/$(database)/documents/expenseGroups/$(expenseGroupId)).data
          );
      }
    }

    // Public read: clients check min version before / without auth (force update).
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.screenName is string
        && request.resource.data.screenName.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow update, delete: if false;
    }

    match /pushEvents/{eventId} {
      allow create: if isAuthenticated()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientIds is list
        && request.resource.data.recipientIds.size() > 0
        && request.resource.data.recipientIds.size() <= 50
        && request.resource.data.pushTokens is list
        && request.resource.data.pushTokens.size() > 0
        && request.resource.data.pushTokens.size() <= 100
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.status == 'pending';
      allow read, update, delete: if false;
    }

    match /overdueNotificationLocks/{lockId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && !exists(/databases/$(database)/documents/overdueNotificationLocks/$(lockId))
        && request.resource.data.itemId is string
        && request.resource.data.occurrence is string
        && request.resource.data.groupId is string
        && request.resource.data.claimedBy == request.auth.uid
        && isGroupMember(request.resource.data.groupId);
      allow update, delete: if false;
    }
  }
}
