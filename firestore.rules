rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    function isGroupOwner(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    function groupAdminIds(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.get('adminIds', []);
    }

    function isGroupAdmin(groupId) {
      return request.auth.uid in groupAdminIds(groupId);
    }

    function isGroupManager(groupId) {
      return isGroupOwner(groupId) || isGroupAdmin(groupId);
    }

    function groupInviteFieldsUnchanged() {
      return request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function groupAdminIdsUnchanged() {
      return request.resource.data.get('adminIds', []) == resource.data.get('adminIds', []);
    }

    function isJoiningGroup() {
      return request.auth.uid in request.resource.data.members
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && groupInviteFieldsUnchanged()
        && groupAdminIdsUnchanged();
    }

    function isMemberLeaving() {
      return request.auth.uid in resource.data.members
        && resource.data.ownerId != request.auth.uid
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && groupInviteFieldsUnchanged()
        && (
          groupAdminIdsUnchanged()
          || (
            request.auth.uid in resource.data.get('adminIds', [])
            && request.resource.data.get('adminIds', []).size()
              == resource.data.get('adminIds', []).size() - 1
          )
        );
    }

    function isOwnerRemovingMember(groupId) {
      return isGroupOwner(groupId)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && resource.data.ownerId in request.resource.data.members
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && groupInviteFieldsUnchanged()
        && request.resource.data.get('adminIds', []).size()
          <= resource.data.get('adminIds', []).size()
        && request.resource.data.get('adminIds', []).size()
          >= resource.data.get('adminIds', []).size() - 1;
    }

    function isAdminRemovingMember(groupId) {
      return isGroupAdmin(groupId)
        && !isGroupOwner(groupId)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && resource.data.ownerId in request.resource.data.members
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && groupInviteFieldsUnchanged()
        && groupAdminIdsUnchanged();
    }

    function isManagerRenaming(groupId) {
      return isGroupManager(groupId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name != resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.members == resource.data.members
        && groupInviteFieldsUnchanged()
        && groupAdminIdsUnchanged();
    }

    function isManagerRegeneratingInvite(groupId) {
      return isGroupManager(groupId)
        && request.resource.data.inviteCode != resource.data.inviteCode
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.members == resource.data.members
        && request.resource.data.createdAt == resource.data.createdAt
        && groupAdminIdsUnchanged();
    }

    function isPromotingMemberToAdmin(groupId) {
      return isGroupManager(groupId)
        && request.resource.data.members == resource.data.members
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && groupInviteFieldsUnchanged()
        && request.resource.data.get('adminIds', []).size()
          == resource.data.get('adminIds', []).size() + 1;
    }

    function isDemotingAdminToMember(groupId) {
      return isGroupOwner(groupId)
        && request.resource.data.members == resource.data.members
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && groupInviteFieldsUnchanged()
        && request.resource.data.get('adminIds', []).size()
          == resource.data.get('adminIds', []).size() - 1;
    }

    function isOwnerTransferringOwnership(groupId) {
      return isGroupOwner(groupId)
        && request.resource.data.ownerId != resource.data.ownerId
        && request.resource.data.ownerId in request.resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.name == resource.data.name
        && groupInviteFieldsUnchanged()
        && request.resource.data.get('adminIds', []).size()
          <= resource.data.get('adminIds', []).size()
        && request.resource.data.get('adminIds', []).size()
          >= resource.data.get('adminIds', []).size() - 1;
    }

    function canReadItemData(data) {
      return isGroupMember(data.groupId)
        && (
          request.auth.uid == data.createdBy
          || request.auth.uid in data.get('assignedTo', [])
          || data.get('visibility', 'everyone') == 'everyone'
          || (
            data.get('visibility', 'everyone') == 'custom'
            && request.auth.uid in data.get('allowedMembers', [])
          )
        );
    }

    function canReadItemById(itemId) {
      return canReadItemData(get(/databases/$(database)/documents/items/$(itemId)).data);
    }

    function itemGroupId(itemId) {
      return get(/databases/$(database)/documents/items/$(itemId)).data.groupId;
    }

    function canAccessItemComments(itemId) {
      return isAuthenticated() && canReadItemById(itemId);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isAuthenticated()
          && request.auth.uid == request.resource.data.actorId
          && request.resource.data.userId == userId
          && request.resource.data.readAt == null
          && request.resource.data.title is string
          && request.resource.data.body is string
          && request.resource.data.createdAt is string;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt is string;
        allow delete: if isOwner(userId);
      }
    }

    match /invites/{inviteCode} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && isGroupManager(request.resource.data.groupId);
      allow update: if isAuthenticated() && isGroupManager(resource.data.groupId);
      allow delete: if isAuthenticated() && isGroupManager(resource.data.groupId);
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if isAuthenticated() && (
        isJoiningGroup()
        || isMemberLeaving()
        || isOwnerRemovingMember(groupId)
        || isAdminRemovingMember(groupId)
        || isManagerRenaming(groupId)
        || isManagerRegeneratingInvite(groupId)
        || isPromotingMemberToAdmin(groupId)
        || isDemotingAdminToMember(groupId)
        || isOwnerTransferringOwnership(groupId)
      );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /items/{itemId} {
      allow read: if isAuthenticated() && canReadItemData(resource.data);
      allow create: if isAuthenticated()
        && isGroupMember(request.resource.data.groupId)
        && request.auth.uid in request.resource.data.get('visibleTo', []);
      allow update, delete: if isAuthenticated() && canReadItemData(resource.data);

      match /comments/{commentId} {
        allow read: if canAccessItemComments(itemId);

        allow create: if canAccessItemComments(itemId)
          && request.auth.uid == request.resource.data.authorId
          && request.resource.data.itemId == itemId
          && request.resource.data.groupId == itemGroupId(itemId)
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.mentionUserIds is list
          && request.resource.data.mentionUserIds.size() <= 50
          && request.resource.data.mentionEveryone is bool
          && !(request.auth.uid in request.resource.data.mentionUserIds);

        allow update: if canAccessItemComments(itemId)
          && request.auth.uid == resource.data.authorId
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.itemId == resource.data.itemId
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.mentionUserIds is list
          && request.resource.data.mentionUserIds.size() <= 50
          && request.resource.data.mentionEveryone is bool
          && !(request.auth.uid in request.resource.data.mentionUserIds);

        allow delete: if canAccessItemComments(itemId) && (
          request.auth.uid == resource.data.authorId
          || (
            resource.data.threadRootId != null
            && resource.data.threadRootId != commentId
            && get(/databases/$(database)/documents/items/$(itemId)/comments/$(resource.data.threadRootId)).data.authorId
              == request.auth.uid
          )
        );
      }
    }

    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.screenName is string
        && request.resource.data.screenName.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow update, delete: if false;
    }

    match /pushEvents/{eventId} {
      allow create: if isAuthenticated()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientIds is list
        && request.resource.data.recipientIds.size() > 0
        && request.resource.data.recipientIds.size() <= 50
        && request.resource.data.pushTokens is list
        && request.resource.data.pushTokens.size() > 0
        && request.resource.data.pushTokens.size() <= 100
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.status == 'pending';
      allow read, update, delete: if false;
    }
  }
}
